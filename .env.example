# --- Google Calendar OAuth ---
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxx
# Generato una sola volta con scripts/setup_google_auth.py (NON committare mai il valore reale)
GOOGLE_REFRESH_TOKEN=

# --- Email (SMTP, es. Gmail con App Password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tuoindirizzo@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
EMAIL_FROM=tuoindirizzo@gmail.com
EMAIL_TO=tuoindirizzo@gmail.com


# --- Sicurezza dashboard/endpoint manuali ---
DASHBOARD_SECRET=cambia-questa-stringa-a-caso

# --- Percorso database SQLite (opzionale, default ./data/briefing.db) ---
DATABASE_PATH=./data/briefing.db
